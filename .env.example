# Configuracion opcional de Miniaturas.
# Copia este archivo como .env para cambiar algun valor; sin .env se usan estos por defecto.
# Lo leen los scripts de arranque, el backend y el frontend.

# Puerto de la interfaz web (el que se abre en el navegador)
FRONTEND_PORT=5173

# Puerto de la API (solo escucha en este equipo; el frontend le reenvia las peticiones)
BACKEND_PORT=3000
